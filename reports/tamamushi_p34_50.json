    "number": 135,
    "latin_name": "Agrilus walanukiorum",
    "japanese_name": "ワタヌキミドリナガタマムシ",
    "emergence_time": "6〜7月",
    "ecological_notes": "6〜7月に現れ、サワシバのスウィーピングで採集される。原産地は新潟県長岡市鋸山。非常に近縁と考えられるA. peregrinus はハンノキ類を寄主植物としている。",
    "host_plants": ["サワシバ"]
  },
  {
    "number": 136,
    "latin_name": "Agrilus viridis",
    "japanese_name": "シンリョクナガタマムシ",
    "emergence_time": "6〜9月",
    "ecological_notes": "北海道と関東地方以北の山間部に6〜9月に現れ、ヤナギ類のスウィーピングで採集されることが多い。体色は唐金色・緑色・青色・鋼赤色・鉄錆色など変化に富む。体長・前胸背板や前胸腹板突起の形状などの変異幅が大きく、ヤナギ属・シラカバ属・ニレ属・コナラ属などの広況な広葉樹の食品を食害することによる寄主植物依存の表現形質の違いを現す。",
    "host_plants": ["ヤナギ属", "シラカバ属", "ニレ属", "コナラ属"]
  },
  {
    "number": 137,
    "latin_name": "Agrilus chujoi",
    "japanese_name": "チュウジョウナガタマムシ",
    "emergence_time": "7〜8月",
    "ecological_notes": "7〜8月に現れ、やや弱気味のクズの葉に集まる。原産地は長崎県対馬仁位。",
    "host_plants": ["クズ"]
  },
  {
    "number": 138,
    "latin_name": "Agrilus motobuanus",
    "japanese_name": "オキナワミドリナガタマムシ",
    "emergence_time": "3〜6月",
    "ecological_notes": "3〜6月に現れ、クスノハカエデの生薬や新鮮な枯れ枝に飛来する。原産地は沖縄今帰仁村。",
    "host_plants": ["クスノハカエデ"]
  },
  {
    "number": 139,
    "latin_name": "Agrilus asakinai",
    "japanese_name": "アサヒナルリナガタマムシ",
    "emergence_time": "6〜7月",
    "ecological_notes": "6〜7月に現れるが少ない。愛知県と静岡県ではツクバネウツギ、北海道ではエゾヒョウタンポクの生葉に飛来する個体が採集され、これらの植物を寄主としていることが確認された。",
    "host_plants": ["ツクバネウツギ", "エゾヒョウタンポク"]
  },
  {
    "number": 140,
    "latin_name": "Agrilus cupes",
    "japanese_name": "ツヤナガタマムシ",
    "emergence_time": "",
    "ecological_notes": "ミツバウツギやバイカウツギの生葉のスウィーピングで採集されるが少ない。幼虫はバイカウツギを食害することが確認された。",
    "host_plants": ["バイカウツギ", "ミツバウツギ"]
  },
  {
    "number": 141,
    "latin_name": "Agrilus sibiricus",
    "japanese_name": "ミドリツヤナガタマムシ",
    "emergence_time": "5〜8月",
    "ecological_notes": "5〜8月に現れ、衰弱したカエデに集まる。西南日本では山間部に限られるが、本州中部以北では丘陵地帯から山間部に普通。",
    "host_plants": ["カエデ類"]
  },
  {
    "number": 142,
    "latin_name": "Agrilus ogatai",
    "japanese_name": "オガタナガタマムシ",
    "emergence_time": "",
    "ecological_notes": "ミドリツヤナガタマムシ日本・極東亜種によく似るが、前胸腹板突起の広がり方、雄交尾器の形から区別できる。7〜8月にアカメカシワの枝先のスウィーピングで採集される。原産地は大分県久住黒岳。",
    "host_plants": ["カエデ類", "キハダ"]
  },
  {
    "number": 143,
    "latin_name": "Agrilus micolanis",
    "japanese_name": "ロニノナガタマムシ",
    "emergence_time": "3〜7月",
    "ecological_notes": "3〜7月に平野部から中山間部に現れ、クヌギ、ハルニレ、ナラ類のひこばえやそだに集まる。原産地はシベリア東部。",
    "host_plants": ["ハルニレ", "クヌギ"]
  },
  {
    "number": 144,
    "latin_name": "Agrilus ribbei",
    "japanese_name": "ホソアシナガタマムシ",
    "emergence_time": "5〜8月",
    "ecological_notes": "5〜8月に平野部から中山間地域に現れ、シデ類、カシ属、ナラ類などの各種広葉のひこばえ、そだ、採水、枯れ木に集まる。本州中部以北では本属中の最普通種。",
    "host_plants": ["シデ類", "カシ類"]
  },
  {
    "number": 145,
    "latin_name": "Agrilus adelphinus",
