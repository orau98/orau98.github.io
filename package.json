{
  "name": "insects-host-plant-explorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://orau98.github.io/",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/postbuild-cleanup.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "fix-butterfly-subfamily": "node scripts/fix_butterfly_subfamily_labels.mjs",
    "fix-butterfly-author-year": "node scripts/fix_butterfly_author_year.mjs",
    "fill-beetle-species": "node scripts/fill_beetle_species_from_subgenus.mjs",
    "fix-beetle-subfamily": "node scripts/fix_beetle_subfamily_labels.mjs",
    "fill-lb": "node scripts/fill_lb_classification.js --cache --cache-version=1",
    "generate-sitemap": "node scripts/generate-sitemap-split.js",
    "generate-meta": "node scripts/generate-meta-pages.js",
    "fill-hostplant-family": "node scripts/fill_hostplant_family.cjs",
    "build-name-family-map": "node scripts/build_name_family_map.cjs",
    "clean-unknown-family": "node scripts/clean_unknown_family.cjs",
    "validate-normalized": "node scripts/validate-normalized.mjs",
    "fix-scientific": "node scripts/fix_scientific_names.mjs",
    "prune-unknown": "node scripts/prune_unknown_insect_refs.mjs",
    "restore-missing-insects": "node scripts/restore_missing_insects_from_cache.mjs",
    "clean-insects-empty": "node scripts/clean_insects_empty_rows.mjs",
    "sort-insects": "node scripts/sort_insects_by_id.mjs",
    "prebuild": "npm run fix-butterfly-subfamily && npm run fix-butterfly-author-year && npm run fix-beetle-subfamily && npm run fill-beetle-species && npm run fix-scientific && npm run validate-normalized && npm run build:data-lite && npm run build:ylist-lite && npm run build:image-index && npm run build:images:responsive && npm run generate-meta && npm run generate-sitemap",
    "deploy": "echo 'Use GitHub Actions: push to main to deploy.'",
    "build:meta": "node tools/add-head-meta.mjs",
    "build:data-lite": "node scripts/build-data-lite.mjs",
    "build:ylist-lite": "node scripts/build-ylist-lite.mjs",
    "build:image-index": "node scripts/build-image-index.mjs",
    "build:images:responsive": "node scripts/build-responsive-images.mjs",
    "lint:html": "node -e \"console.log('lint ok')\"",
    "format": "prettier -w ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.56.0",
    "@heroicons/react": "^2.1.3",
    "csv-parser": "^3.2.0",
    "csv-writer": "^1.6.0",
    "papaparse": "^5.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3",
    "tailwind-scrollbar": "^3.0.0",
    "tailwindcss": "^3.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "gh-pages": "^6.3.0",
    "globals": "^16.0.0",
    "postcss": "^8.5.6",
    "vite": "^6.3.5",
    "sharp": "^0.33.4"
  }
}
